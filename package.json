{
  "name": "dsh-bot-team-tab",
  "version": "0.3.1",
  "description": "One left-rail row per DS Bot teammate, labelled with the Bot's own name: click it and the workspace opens that Bot's session. Also adds a BOT chip on Bot sessions in the session list.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs/验收.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ds-bot",
    "team",
    "roster",
    "sidebar"
  ],
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
